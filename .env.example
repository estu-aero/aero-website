# AERO sitesi ortam değişkenleri şablonu.
# Kullanım: bu dosyayı ".env.local" adıyla kopyalayın ve değerleri doldurun.
# .env.local asla GitHub'a gönderilmez (.gitignore dışarıda tutar) ve içeriği kimseyle paylaşılmaz.
# Aynı değerler Vercel'de Settings > Environment Variables bölümüne de girilir.

# --- Firebase (tarayıcı tarafı): Firebase Console > Project settings > Your apps > Web app ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase (sunucu tarafı): Project settings > Service accounts > Generate new private key ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Anahtar tırnak içinde ve tek satırda yazılır; satır sonları \n olarak kalır
FIREBASE_PRIVATE_KEY=

# --- Admin paneline girebilecek e-postalar (virgülle ayrılır) ---
# Buradaki her e-posta için Firebase Console > Authentication'da bir kullanıcı da açılmalıdır.
ADMIN_EMAILS=

# --- Resend (bülten mailleri) ---
RESEND_API_KEY=
# Alan adı Resend'de doğrulandıktan sonra, ör: ESTÜ AERO <bulten@alanadi.org>
RESEND_FROM=

# --- Web3Forms (iletişim formu) ---
NEXT_PUBLIC_WEB3FORMS_KEY=

# --- Vercel Blob (etkinlik görselleri, dergi PDF ve kapakları, sertifikalar) ---
# Vercel'de Storage > Blob deposu projeye bağlanınca otomatik eklenir.
# Yerelde denemek için: Vercel > Storage > depo > .env.local sekmesindeki değeri kopyalayın.
BLOB_READ_WRITE_TOKEN=
